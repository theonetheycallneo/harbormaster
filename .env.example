# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://harbormaster:harbormaster@localhost:5442/harbormaster

# BetterAuth — generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Optional. When unset, Harbormaster falls back to a deterministic hashed
# bag-of-words embedding (lexical baseline) so the whole demo runs with
# zero external API keys. Set a key for real semantic retrieval.
# OPENAI_API_KEY=sk-...
